{
  "name": "eco-backend",
  "version": "1.0.0",
  "description": "ECO Gaming Platform - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build-ts": "tsc",
    "build": "tsc && (cp -r src/data dist/data 2>/dev/null || xcopy /E /I src\\data dist\\data 2>nul || true)",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["gaming", "booking", "platform"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.5.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.6.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
